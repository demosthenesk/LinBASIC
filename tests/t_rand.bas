OPEN "R.DAT" FOR OUTPUT AS #1: CLOSE #1
OPEN "R2.DAT" FOR OUTPUT AS #1: CLOSE #1
OPEN "OUT.TXT" FOR OUTPUT AS #1: CLOSE #1
OPEN "R.DAT" FOR RANDOM AS #1 LEN = 10
A$ = "ABC"
PUT #1, 1, A$
B$ = "XY"
PUT #1, 2, B$
CLOSE #1
OPEN "R.DAT" FOR BINARY AS #1
OPEN "OUT.TXT" FOR APPEND AS #2
PRINT #2, LOF(1)
FOR I = 1 TO LOF(1)
C$ = " "
GET #1, I, C$
PRINT #2, ASC(C$);
NEXT
PRINT #2,
CLOSE #1
OPEN "R.DAT" FOR RANDOM AS #1 LEN = 10
G$ = SPACE$(5)
GET #1, 1, G$
PRINT #2, "["; G$; "]"; LEN(G$)
H$ = ""
GET #1, 2, H$
PRINT #2, "["; H$; "]"; LEN(H$)
CLOSE
TYPE T
  A AS INTEGER
  S AS STRING * 3
END TYPE
DIM R AS T
DIM F AS STRING * 4
OPEN "OUT.TXT" FOR APPEND AS #2
OPEN "R2.DAT" FOR RANDOM AS #1 LEN = 8
X% = 258: PUT #1, 1, X%
PRINT #2, LOF(1);
R.A = 7: R.S = "QQ": PUT #1, 2, R
PRINT #2, LOF(1);
F = "ZZ": PUT #1, 3, F
PRINT #2, LOF(1);
Y# = 1: PUT #1, 4, Y#
PRINT #2, LOF(1);
ON ERROR GOTO EH
L$ = "1234567": PUT #1, 5, L$
PRINT #2, LOF(1);
L$ = "123456": PUT #1, 5, L$
PRINT #2, LOF(1)
E$ = "": PUT #1, 6, E$
PRINT #2, LOF(1)
CLOSE #1
OPEN "R2.DAT" FOR BINARY AS #1
FOR I = 1 TO LOF(1): C$ = " ": GET #1, I, C$: PRINT #2, ASC(C$); : NEXT
PRINT #2,
CLOSE #1
OPEN "R2.DAT" FOR RANDOM AS #1 LEN = 8
GET #1, 5, L$: PRINT #2, "["; L$; "]"
GET #1, 3, F: PRINT #2, "["; F; "]"; ASC(MID$(F, 4))
Z$ = "abc": GET #1, 9, Z$: PRINT #2, "["; Z$; "]"; LEN(Z$)
GET #1, 1, Z$: PRINT #2, LEN(Z$)
CLOSE
END
EH: PRINT #2, "ERR"; ERR; : RESUME NEXT
